# Copy to .env and fill in the remaining values.
# Values from Old_DB_details in DB_details.txt are already set (current PostgreSQL).

# --- Review PostgreSQL (required for the web app, polling, and CLI) ---
REVIEW_DB_NAME=review
REVIEW_DB_USER=review
# FILL IN: not in DB_details.txt
REVIEW_DB_PASSWORD=
REVIEW_DB_HOST=meqpacscrllt01
REVIEW_DB_PORT=5432

# New ReportReview SQL Server. false = PostgreSQL (old). true = SQL Server.
# Same keys as hl7-receiver.
mssql_db_enabled = false
mssql_db_name = ''
mssql_db_user = ''
mssql_db_password = ''
mssql_db_host = ''
mssql_db_port = ''

# --- Microsoft Entra ID login (required for the web app) ---
# FILL IN
CLIENT_ID=
# FILL IN
CLIENT_SECRET=
# FILL IN (defaults to "common" if left empty)
TENANT_ID=
# FILL IN, e.g. https://your-host.example  (no trailing slash; redirect is {SERVER_URL}/getAToken)
SERVER_URL=

# --- Who-is-who / admin (required when a user hits admin checks) ---
# FILL IN
WHO_IS_WHO_URL=
WHO_IS_WHO_VERIFY_SSL=true
# FILL IN, e.g. a login name; code does substring match on this string
ADMIN_USERS=

# --- Optional ---
LOG_LEVEL=INFO
# Local only. false = Entra + who-is-who required. true = fake logged-in admin, skip those.
TESTING=false
# Local bind address. Read only when TESTING=true. Use another port for a second instance.
TESTING_HOST=127.0.0.1
TESTING_PORT=5000

# --- Sectra CDWH (only for the CLI command that opens that SQL Server; not the web app) ---
# FILL IN if you use that CLI command
SECTRA_USER=
SECTRA_PASSWORD=
SECTRA_HOST=
SECTRA_PORT=
SECTRA_DB=
